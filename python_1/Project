#start
import random

# This function runs the number guessing game and tracks the player's guesses.
def play_game():
    print("Welcome to the Number Guessing Game!")
    print("------------------------------------")

    name = input("What is your name? ")
    #This function asks the user for their name to continue
    print("Good luck,", name)

    number = random.randint(1, 100)
    #generates a radnom number between 1 aand a 100
    max_attempts = 10

    attempts = 0
    exceeded_limit = False
# This function does not allow the number guessed to be over 100

    guess_history = []

    while attempts < max_attempts:
        guess = int(input("Guess a number between 1 and 100: "))

        if guess < 1 or guess > 100:
            print("You exceeded the number limit! Game over.")
            #if the limit is used (10 guesses) the game is over
            exceeded_limit = True
            break

        guess_history.append(guess)
        attempts += 1

        if guess == number:
            print("Congratulations!", name, "You guessed correctly!")
            break
        elif guess < number:
            print("Too low! Try again.")
        else:
            print("Too high! Try again.")

    print("Your guess history:", guess_history)
# keeps your histroy of each guess and shows it at the end of the run

    if not exceeded_limit and attempts == max_attempts and guess != number:
        print("Game over! You've used all your attempts.")
        print("The correct number was", number)


play_game()
 